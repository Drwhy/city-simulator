+import type { CommunicationOverview } from "../types/city";
+import { channelLabel, statusLabel } from "./CommunicationPanel";
+import "./Communications.css";
+export function CommunicationModal({ open, data, onClose, onSelectCitizen }: { open: boolean; data: CommunicationOverview | null; onClose: () => void; onSelectCitizen: (id: number) => void }) {
+ if (!open) return null;
+ return <div className="citizen-modal-overlay" role="dialog" aria-modal="true" aria-label="Monitoring des communications" onMouseDown={onClose}><section className="citizen-modal communication-monitor" onMouseDown={(event) => event.stopPropagation()}><header className="citizen-modal-header"><div><div className="eyebrow">Téléphone · SMS · e-mail · courrier</div><h2>Communications</h2></div><button onClick={onClose}>Fermer</button></header><div className="communication-kpis"><span><b>{data?.metrics.sentToday ?? 0}</b> envoyées</span><span><b>{data?.metrics.unreadCommunications ?? 0}</b> non lues</span><span><b>{data?.metrics.phoneCallsToday ?? 0}</b> appels</span><span><b>{data?.metrics.communicationRepliesToday ?? 0}</b> réponses</span></div><div className="communication-monitor-list">{data?.recent.length ? data.recent.map((message) => <article className={`communication-row communication-${message.status}`} key={message.id}><header><span><button onClick={() => onSelectCitizen(message.sender.id)}>{message.sender.name}</button> → <button onClick={() => onSelectCitizen(message.recipient.id)}>{message.recipient.name}</button></span><b>{channelLabel(message.channel)} · {statusLabel(message.status)}</b></header><strong>{message.subject}</strong><p>{message.body}</p></article>) : <p className="muted">Aucune communication récente.</p>}</div></section></div>;
+}
