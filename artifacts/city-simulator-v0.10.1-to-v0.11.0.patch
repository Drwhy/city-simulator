+  <section className="profile-section"><h3>Tendances journalières</h3>{data.history.length===0?<p className="muted">Les premières tendances seront disponibles à la fin de la journée.</p>:<div className="neighborhood-history">{data.history.slice(-14).reverse().map((row)=><article key={row.day}><b>J{row.day}</b><span>Sécurité {number.format(row.safetyPerception)} %</span><span>Crime {number.format(row.criminality)}</span><span>Attractivité {number.format(row.attractiveness)} %</span></article>)}</div>}</section>
